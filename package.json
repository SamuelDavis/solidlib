{
  "name": "@samueldavis/solidlib",
  "author": "Samuel Davis",
  "version": "1.0.0",
  "homepage": "https://github.com/SamuelDavis/solidlib",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamuelDavis/solidlib"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "src/index.tsx",
  "types": "src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "pretty": "prettier --write \"{src}/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "prettier": "^3.4.1",
    "solid-js": "^1.9.3",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "solid-js": "^1.8.6"
  }
}
